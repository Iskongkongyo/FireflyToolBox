<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="oval">
      <size android:width="48dp" android:height="48dp" />
      <solid android:color="@color/ic_launcher_background" />
    </shape>
  </item>
  <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
    <bitmap android:src="@mipmap/ic_launcher_foreground" android:gravity="fill" android:filter="true" />
  </item>
</layer-list>
