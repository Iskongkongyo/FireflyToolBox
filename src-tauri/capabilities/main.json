{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主应用窗口的基础能力",
  "windows": [
    "main"
  ],
  "permissions": [
    "main-commands",
    "core:default",
    "core:webview:allow-create-webview-window",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/Iskongkongyo/FireflyToolBox" },
        { "url": "https://firefly.202132.xyz" }
      ]
    }
  ]
}
