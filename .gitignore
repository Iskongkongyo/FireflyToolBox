# Only project directories and required root files belong in the repository.
# Add new project root entries here when needed; local references stay private.
/*
!/.cargo/
!/.github/
!/crates/
!/docs/
!/examples/
!/png/
!/public/
!/scripts/
!/skills/
!/src/
!/src-tauri/
!/vendor/
!/.gitattributes
!/.gitignore
!/Cargo.lock
!/Cargo.toml
!/LICENSE
!/index.html
!/package-lock.json
!/package.json
!/splash.html
!/tsconfig.json
!/uno.config.ts
!/vite.config.ts

# Keep local notes, prototypes and documentation sites out of commits.
# Traverse these directories only so README/SKILL documents can be retained.
/docs/**
!/docs/**/
/vendor/rquickjs-sys/quickjs/docs/**
!/vendor/rquickjs-sys/quickjs/docs/**/
*.md
/CHANGELOG.md
!README.md
!README.*.md
!SKILL.md
!SKILL.*.md

# Required attribution is project data, including text read by the OCR build.
!/src-tauri/builtin-tools/data/ocr-models/MODEL-NOTICE.md
!/vendor/rquickjs-sys/vendor/wasi-libc/NOTICE.md

# Root asset originals and unused artwork stay local; runtime data lives in src/assets.
/drawer_wallpaper.png
/流萤语句.txt
/assets/

# Retain the Cargo build configuration, not registry caches or credentials.
/.cargo/*
!/.cargo/config.toml

# The former browser prototype is a local reference, not the application source.
/docs/prototype/

# Current Windows/Android builds use these three shared icons.
# Android launcher resources remain in src-tauri/gen/android/app/src/main/res/.
/src-tauri/icons/*
!/src-tauri/icons/32x32.png
!/src-tauri/icons/icon.ico
!/src-tauri/icons/icon.png

